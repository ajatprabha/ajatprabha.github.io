{
  "name": "ajatprabha-field-journal",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && astro dev --host 0.0.0.0",
    "check": "astro check && node --test scripts/table-regions.test.mjs",
    "validate:content": "astro sync && node scripts/validate-content.mjs",
    "build": "node scripts/prepare-assets.mjs && astro build",
    "build:review": "THEME_REFERENCE=1 npm run build",
    "validate:output": "node scripts/validate-output.mjs",
    "validate:feeds": "node scripts/validate-feeds.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "validate:composition": "node tests/browser/verify-composition.mjs",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.3",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.11.2",
    "fast-xml-validator": "1.4.2",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
