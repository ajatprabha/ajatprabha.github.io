---
import type { ArticleSummary } from "../../lib/types";
interface Props {
  article: ArticleSummary;
  headingLevel?: 1 | 2;
}
const { article, headingLevel = 1 } = Astro.props;
const Heading = headingLevel === 1 ? "h1" : "h2";
---

<article class="article-layout">
  <header class="article-header">
    <Heading>{article.title}</Heading>
    <slot name="metadata" />
  </header>
  {Astro.slots.has("outline") && (
    <aside class="article-outline" aria-label="On this page">
      <slot name="outline" />
    </aside>
  )}
  <div class="reading-body prose">
    <slot />
  </div>
  {Astro.slots.has("related") && (
    <section class="related-section" aria-label="Related writing">
      <slot name="related" />
    </section>
  )}
</article>
