---
import type { ArticleSummary } from '../../lib/types';
interface Props { article: ArticleSummary }
const { article } = Astro.props;
---
<article class="article-layout"><header class="article-header"><h1>{article.title}</h1><slot name="metadata"/></header>{Astro.slots.has('outline') && <aside class="article-outline" aria-label="On this page"><slot name="outline"/></aside>}<div class="reading-body prose"><slot/></div>{Astro.slots.has('related') && <section class="related-section" aria-label="Related writing"><slot name="related"/></section>}</article>
