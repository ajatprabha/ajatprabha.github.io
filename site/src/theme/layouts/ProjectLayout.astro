---
import type { ProjectSummary } from "../../lib/types";
interface Props {
  project: ProjectSummary;
  headingLevel?: 1 | 2;
}
const { project, headingLevel = 1 } = Astro.props;
const Heading = headingLevel === 1 ? "h1" : "h2";
---

<article class="project-layout">
  <header class="project-header">
    <Heading>{project.title}</Heading>
    <p>{project.description}</p>
    <slot name="metadata" />
  </header>
  {Astro.slots.has("preview") && (
    <div class="project-preview">
      <slot name="preview" />
    </div>
  )}
  <div class="reading-body prose">
    <slot />
  </div>
  {Astro.slots.has("related") && (
    <section class="related-section" aria-label="Related writing">
      <slot name="related" />
    </section>
  )}
</article>
