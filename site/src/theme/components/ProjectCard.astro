---
import type { ProjectSummary } from '../../lib/types';
interface Props { project: ProjectSummary; headingLevel?: 2 | 3 }
const { project, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---
<article class="project-card"><Heading><a href={project.href}>{project.title}</a></Heading><p>{project.description}</p>{project.status && <span class="metadata">{project.status}</span>}<slot/></article>
