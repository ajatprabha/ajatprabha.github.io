---
import type { ProjectSummary } from '../../lib/types';
interface Props { project: ProjectSummary }
const { project } = Astro.props;
---
<article class="project-card"><h3><a href={project.href}>{project.title}</a></h3><p>{project.description}</p>{project.status && <span class="metadata">{project.status}</span>}<slot/></article>
