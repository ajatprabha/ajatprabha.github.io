---
import { site, navigation } from "../data/site";
import {
  getWriting,
  getProjects,
  toArticleSummary,
  toProjectSummary,
} from "../lib/content";
import {
  SiteShell,
  HomeLayout,
  FeaturedArticle,
  ArticleCard,
  ProjectCard,
} from "../theme";
import { metadata } from "./_metadata";
const [writing, projects] = await Promise.all([getWriting(), getProjects()]);
const [latest, ...recent] = writing;
const featured = latest ? toArticleSummary(latest) : undefined;
---

<SiteShell
  site={site}
  navigation={navigation}
  metadata={metadata("Field journal", site.description, "/", { image: featured?.cover })}
>
  <HomeLayout>
    <div slot="writing">
      <h1>Recent writing</h1>
      {featured && <FeaturedArticle article={featured} headingLevel={2} />}
      <div class="article-card-grid">
        {
          recent
            .slice(0, 3)
            .map((entry) => <ArticleCard article={toArticleSummary(entry)} headingLevel={2} />)
        }
      </div>
      <a href="/writing/">All writing</a>
    </div>
    <div slot="projects">
      <h2>Selected projects</h2>
      <p>Tools and systems I've built.</p>
      <div class="project-grid">
        {
          projects
            .slice(0, 3)
            .map((entry) => <ProjectCard project={toProjectSummary(entry)} />)
        }
      </div>
      <a href="/projects/">All projects</a>
    </div>
    <p slot="note">
      Follow new entries through <a href="/feed.xml">RSS</a>, or visit my <a
        href="https://ajatprabha.in/gsoc-meta-k8s/">GSoC 2019 project archive</a
      >.
    </p>
  </HomeLayout>
</SiteShell>
