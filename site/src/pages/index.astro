---
import { site, navigation } from "../data/site";
import {
  getWriting,
  getProjects,
  toArticleSummary,
  toProjectSummary,
} from "../lib/content";
import {
  SiteShell,
  HomeLayout,
  HomeHero,
  FeaturedArticle,
  ArticleCard,
  ProjectCard,
} from "../theme";
import { metadata, introduction } from "./_metadata";
const [writing, projects] = await Promise.all([getWriting(), getProjects()]);
const hero = {
  src: "/assets/images/blog-cover.jpg",
  alt: "",
  width: 2000,
  height: 666,
};
const [latest, ...recent] = writing;
---

<SiteShell
  site={site}
  navigation={navigation}
  metadata={metadata("Field journal", site.description, "/", { image: hero })}
>
  <HomeLayout>
    <HomeHero slot="intro" image={hero} title="Ajat Prabha">
      <span slot="eyebrow">Engineering field journal</span>
      <p>{introduction}</p>
      <nav slot="actions" aria-label="Explore the site">
        <a href="/writing/">Writing</a>
        <a href="/projects/">Projects</a>
        <a href="/about/">About me</a>
      </nav>
    </HomeHero>
    <div slot="writing">
      <h2>Recent writing</h2>
      {latest && <FeaturedArticle article={toArticleSummary(latest)} />}
      <div class="article-card-grid">
        {
          recent
            .slice(0, 3)
            .map((entry) => <ArticleCard article={toArticleSummary(entry)} />)
        }
      </div>
      <a href="/writing/">All writing</a>
    </div>
    <div slot="projects">
      <h2>Selected projects</h2>
      <p>Tools and systems I've built.</p>
      <div class="project-grid">
        {
          projects
            .slice(0, 3)
            .map((entry) => <ProjectCard project={toProjectSummary(entry)} />)
        }
      </div>
      <a href="/projects/">All projects</a>
    </div>
    <p slot="note">
      Follow new entries through <a href="/feed.xml">RSS</a>, or visit my <a
        href="https://ajatprabha.in/gsoc-meta-k8s/">GSoC 2019 project archive</a
      >.
    </p>
  </HomeLayout>
</SiteShell>
